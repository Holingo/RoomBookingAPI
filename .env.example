# Przykładowe wartości wyłącznie do lokalnego uruchomienia.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=room_booking
POSTGRES_PORT=5432

# DATABASE_URL służy do uruchomienia Node.js na hoście.
# Compose przekazuje DOCKER_DATABASE_URL pod nazwą DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/room_booking
DOCKER_DATABASE_URL=postgresql://postgres:password@db:5432/room_booking

PORT=3000
API_PORT=3001
JWT_SECRET=local-room-booking-demo-signing-key-change-me
JWT_EXPIRES_IN=15m
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=LocalRoomBookingAdmin123
